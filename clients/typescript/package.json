{
  "name": "@ouijan/laya-client",
  "version": "0.2.0",
  "description": "Typed TypeScript client for laya-serve, generated from its OpenAPI spec",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouijan/laya-serve.git",
    "directory": "clients/typescript"
  },
  "scripts": {
    "spec": "cd ../.. && mise exec -- python -m laya_serve.openapi > clients/typescript/openapi.json",
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.ts",
    "compile": "tsc -p tsconfig.build.json",
    "build": "bun run spec && bun run generate && bun run compile",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck",
    "prepack": "cp ../../LICENSE ./LICENSE"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0"
  }
}
